{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "src/server.js"
    }
  },
  "env": {
    "NODE_ENV": "production",
    "GOOGLE_CLIENT_ID": "611343899369-2itb08p2u9rhumhh9a308c82r82mektg.apps.googleusercontent.com",
    "VITE_GOOGLE_CLIENT_ID": "611343899369-2itb08p2u9rhumhh9a308c82r82mektg.apps.googleusercontent.com"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
