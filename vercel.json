{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "installCommand": "npm install",
      "entrypoint": "src/server.js"
    }
  },
  "env": {
    "GOOGLE_CLIENT_ID": "611343899369-2itb08p2u9rhumhh9a308c82r82mektg.apps.googleusercontent.com",
    "VITE_GOOGLE_CLIENT_ID": "611343899369-2itb08p2u9rhumhh9a308c82r82mektg.apps.googleusercontent.com"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
